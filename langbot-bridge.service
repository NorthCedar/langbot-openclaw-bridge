[Unit]
Description=LangBot-OpenClaw Bridge
After=network.target

[Service]
Type=simple
ExecStart=/root/.nvm/versions/node/v22.22.2/bin/node /root/.openclaw/workspace/langbot-bridge/bridge.js
Restart=always
RestartSec=3
WorkingDirectory=/root/.openclaw/workspace/langbot-bridge
Environment=NODE_ENV=production
MemoryMax=128M
CPUQuota=50%

[Install]
WantedBy=default.target
